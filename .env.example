# Copy this file to `.env.local` for development, or paste the same two values
# into the storefront's Vercel project before the first deploy. Use the SAME
# project as the admin panel - that shared database is the whole point.
#
# Both values are public by design: the anon key can only do what the row-level
# policies in `supabase/schema.sql` allow - read published products, place an
# order, track one order with its phone or token, and write an anonymous event.
#
# Without these two values the shop still renders the built-in fallback
# catalogue (data/products.ts), so local UI work needs no Supabase project.
# Checkout and tracking, however, only work against a real project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server-only values. None of these may take a NEXT_PUBLIC_ prefix: anything
# with that prefix is inlined into the JavaScript the browser downloads, and
# these three open the database and the mail account.
#
# The shop runs without all of them — checkout, tracking and the catalogue are
# unaffected. Only order emails stop, and the queue keeps the rows until it is
# configured, so nothing is lost.
# ---------------------------------------------------------------------------

# Lets the outbox worker read and update public.email_outbox, which has no
# row-level-security policies of its own because customer addresses live in it.
# This is the only place either app uses it. Dashboard → Settings → API →
# service_role. Treat it as a password: server environment only, never a
# NEXT_PUBLIC_ name, never committed.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo (formerly Sendinblue) transactional mail. Free plan is 300 emails a day.
# The sending address must be on a domain you have verified in Brevo — SPF,
# DKIM and DMARC — because mail from a @gmail address will not survive the hop.
# BREVO_API_KEY=your-brevo-smtp-api-key
# BREVO_FROM_EMAIL=orders@your-domain.example
# BREVO_FROM_NAME=OCNOO Online Store
# Where "new order" mail goes. Defaults to BREVO_FROM_EMAIL if unset.
# BREVO_ADMIN_EMAIL=shopowner@your-domain.example

# Guards /api/worker/outbox. Vercel sends it automatically on cron hits; set the
# same value in the project's environment. Without it the route answers 503 to
# everyone, which is the safe failure.
# CRON_SECRET=a-long-random-string
