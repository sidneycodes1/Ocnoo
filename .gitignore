# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# local dev server log (detached npm run dev redirect)
dev.log

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# `.env*.local` alone left a plain `.env` committable, and this repo has a live
# GitHub remote - one hand-named `.env` would have pushed the database keys with
# it. Ignore every variant and un-ignore only the documented template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
